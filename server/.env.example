# Nuvik Vet API. In Compose, use the internal PostgreSQL service hostname.
PORT=4108

# Supply a dedicated Nuvik database URL and independently generated secret.
DATABASE_URL=postgres://nuvik_vet_user:REPLACE_WITH_NUVIK_DB_PASSWORD@nuvik-vet-db:5432/nuvik_vet

SECRETJWT_SECRETCHANGE_ME
JWT_ISSUER=nuvik-vet
JWT_AUDIENCE=nuvik-vet-api

JWT_EXPIRES_IN=12h

CLIENT_ORIGIN=http://localhost:5178,http://127.0.0.1:5178,http://localhost:8090,http://127.0.0.1:8090,https://localhost:8449,https://127.0.0.1:8449
JWT_SECRET=CHANGE_ME
