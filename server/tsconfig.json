{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/app.ts",
    "src/routes/customersAnimals.routes.ts",
    "src/routes/catalog.routes.ts",
    "src/routes/pos.routes.ts",
    "src/lib/decimalMoney.ts",
    "src/auth.integration.test.ts",
    "src/demo.integration.test.ts",
    "src/pos.integration.test.ts",
    "src/ux.integration.test.ts",
    "src/bootstrap.ts",
    "src/db.ts",
    "src/env.ts",
    "src/index.ts",
    "src/middleware/auth.ts",
    "src/routes/auth.routes.ts",
    "src/routes/users.routes.ts",
    "src/socket.ts",
    "src/types.ts"
  ]
}
